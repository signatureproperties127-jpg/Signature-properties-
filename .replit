modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 4173

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 4173
externalPort = 80

[[ports]]
localPort = 4180
externalPort = 3002

[[ports]]
localPort = 4181
externalPort = 3003

[[ports]]
localPort = 4186
externalPort = 3000

[[ports]]
localPort = 4193
externalPort = 3001
